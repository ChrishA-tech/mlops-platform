{
  "title": "MLOps Serving",
  "schemaVersion": 39,
  "timezone": "browser",
  "panels": [
    {
      "type": "timeseries", "title": "Request rate (req/s)", "id": 1,
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [{"expr": "sum(rate(predict_requests_total[1m])) by (status)", "legendFormat": "{{status}}"}]
    },
    {
      "type": "timeseries", "title": "p95 latency (s)", "id": 2,
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [{"expr": "histogram_quantile(0.95, sum(rate(predict_latency_seconds_bucket[5m])) by (le))", "legendFormat": "p95"}]
    },
    {
      "type": "stat", "title": "Error rate", "id": 3,
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [{"expr": "sum(rate(predict_requests_total{status=\"error\"}[5m])) / clamp_min(sum(rate(predict_requests_total[5m])), 1)"}]
    }
  ]
}
